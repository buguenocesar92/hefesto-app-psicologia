# =============================================================================
# Hefesto Studio - Psicologia: API
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
#
# Las variables con texto de ejemplo se cambian. Las que vienen vacías NO se
# inventan: hay que ponerles un valor real de la instalación.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_NAME=Psicologia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Santiago

# Debe ser el mismo valor que la interfaz usa para firmar la cookie de sesión.
# Si cambia, todas las sesiones abiertas dejan de valer y hay que entrar de nuevo.
APP_SESSION_SECURE_COOKIE=false

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# PostgreSQL, y no por gusto: el aislamiento entre consultorios usa Row Level
# Security, que es una función de este motor. En SQLite no existiría.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=psicologia
DB_USERNAME=psicologia
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=psicologia_admin
DB_ADMIN_PASSWORD=

# Conexión aparte para la bitácora de accesos. Tiene que ser una conexión
# DISTINTA, no la misma con otro nombre: el registro de un intento denegado
# se escribe fuera de la transacción de la petición, porque la petición se
# revierte justo cuando el permiso se rechaza.
DB_AUDITORIA_HOST=postgres
DB_AUDITORIA_PORT=5432
DB_AUDITORIA_DATABASE=psicologia
DB_AUDITORIA_USERNAME=psicologia
DB_AUDITORIA_PASSWORD=
DB_AUDITORIA_SSLMODE=prefer

DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Caché y colas
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=30
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# -----------------------------------------------------------------------------
# URL PÚBLICA del emisor, sin barra final. El descubrimiento OIDC se lee de
# `<issuer>/.well-known/openid-configuration`, así que tiene que ser la que
# el navegador puede alcanzar, no el nombre de un contenedor de Docker.
AUTHENTIK_ISSUER=https://identidad.ejemplo.cl
AUTHENTIK_CLIENT_ID=psicologia
AUTHENTIK_CLIENT_SECRET=

# Tiene que coincidir carácter por carácter con la URL de retorno registrada
# en Authentik. Un slash de más hace fallar el ingreso con un error inútil.
AUTHENTIK_REDIRECT_URI=http://localhost:8080/auth/callback

AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_AUDIENCE=
AUTHENTIK_LEEWAY=60

AUTHENTIK_CACHE_METADATA=60
AUTHENTIK_CACHE_JWKS=1440

# El equipo con este prefijo declara a qué consultorio pertenece la persona.
# Su contenido es el identificador o el slug del consultorio.
AUTHENTIK_GRUPO_POR_CONSULTORIO=Psicologia
AUTHENTIK_PREFIJO_EQUIPO_CONSULTORIO=consultorio-
AUTHENTIK_EQUIPO_PROFESIONAL=Profesionales de Psicologia
AUTHENTIK_EQUIPO_ADMINISTRATIVO=Administrativos de Psicologia
AUTHENTIK_EQUIPO_ADMINISTRADOR=Administradores de Psicologia
AUTHENTIK_CLAIM_GRUPOS=groups

# -----------------------------------------------------------------------------
# Reglas del consultorio
# -----------------------------------------------------------------------------
# Duración máxima de una sesión, en minutos. Es la red de seguridad para
# cuando el catálogo de tipos de atención tiene un dato raro. La duración real
# de cada tipo sale de `tipos_atencion.duracion_minutos`.
PSICOLOGIA_DURACION_MAXIMA_MINUTOS=180

# Con cuántos días de anticipación se puede agendar como máximo.
PSICOLOGIA_ANTICIPACION_MAXIMA_DIAS=180

# -----------------------------------------------------------------------------
# CONSERVACIÓN: DEJAR EN VACÍO HASTA QUE EL CLIENTE LO DECIDA
# -----------------------------------------------------------------------------
# NO HAY VALOR POR OMISIÓN, Y NO ES UN OLVIDO.
#
# No se pudo verificar en el entorno donde se escribió esta aplicación qué
# plazo de conservación corresponde a una ficha de salud mental, y aunque se
# hubiera verificado, no hay un plazo único que sirva para todos los datos de
# un consultorio. Es una decisión del cliente, con su asesoría legal.
#
# Vacío significa "no hay plazo configurado", y el sistema NO borra nada por
# su cuenta. La razón de que sea así está en `config/psicologia.php` y en
# docs/06. No complete estos valores con un número que le parezca razonable.
#
# PSICOLOGIA_RETENCION_NOTAS_DIAS=
# PSICOLOGIA_RETENCION_ACCESOS_DIAS=
# PSICOLOGIA_RETENCION_DERIVACIONES_DIAS=
PSICOLOGIA_AVISAR_ANTES_DE_PURGAR=false

# -----------------------------------------------------------------------------
# Instrumentos de evaluación
# -----------------------------------------------------------------------------
# Días para recordar que hay una aplicación sin puntaje cargado. Vacío = no se
# recuerda nada. Es una ayuda de trabajo, no un plazo clínico.
# PSICOLOGIA_DIAS_RECORDATORIO_INSTRUMENTO=

# -----------------------------------------------------------------------------
# Registro
# -----------------------------------------------------------------------------
# Los registros van a stderr y los recoge el orquestador de contenedores.
# `sterilized` borra los datos personales del registro antes de escribirlo.
# Ver docs/06.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Correo
# -----------------------------------------------------------------------------
# NO HAY CORREO SALIENTE IMPLEMENTADO. No hay alertas automáticas por correo,
# aunque la configuración contemplate umbrales. Ver docs/10.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-responder@ejemplo.cl
MAIL_FROM_NAME=Psicologia